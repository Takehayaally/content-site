---
import { Image } from "astro:assets";
import skincareCard from "@/assets/images/portfolio/aster-dew-brand-hero.png";
import automotiveCard from "@/assets/images/portfolio/auto-wrap-su7-firefly.webp";
import cosplayComparison from "@/assets/images/portfolio/cosplay-retouch-direction-comparison.webp";
import novaMerchSystem from "@/assets/images/portfolio/nova-merch-system.webp";
import openEarHero from "@/assets/images/portfolio/open-ear-auralink-hero.png";
import zhaoshuangSystem from "@/assets/images/portfolio/zhaoshuang-character-system.webp";
import moonlitTeaCover from "@/assets/images/portfolio/moonlit-tea-character.webp";
import whiskyPort from "@/assets/images/portfolio/whisky-port-poster.png";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="NOVA" description="商品视觉、二次元角色设计、AI 图片生产、PS/AI 后期和质量控制案例。" ogImage={automotiveCard.src}>
	<header class="page-hero page-hero--directory site-shell"><div class="page-hero__grid">
		<div><p class="eyebrow">NOVA / AI VISUAL &amp; COMMERCE PRODUCTION</p><h1 class="page-title">角色设定、<br />商品视觉与 AI 生产。</h1></div>
		<p class="page-summary">这里展示商品视觉、二次元角色、品牌延展、动态镜头与 AI 辅助生产方法。每个项目都保留从设定、生成、精修到交付的关键过程。</p>
	</div><nav class="work-directory" aria-label="作品目录"><a href="#selected-work"><span>01</span><strong>精选作品</strong><small>商品、角色与动态视觉</small></a><a href="/resume/"><span>02</span><strong>经历与能力</strong><small>11 年设计与物料经验</small></a><a href="/fanworks/"><span>03</span><strong>同人创作</strong><small>非商业视觉研究</small></a><a href="/systems/"><span>04</span><strong>系统与工具</strong><small>公开工作流</small></a><a href="/about/#contact"><span>05</span><strong>关于与联系</strong><small>邮箱 / 微信</small></a></nav></header>

	<section class="section" id="selected-work"><div class="site-shell work-list">
		<a class="work-card" href="/work/ai-automotive-visual/"><div class="work-card__visual"><Image src={automotiveCard} alt="小米 SU7 二次元主题车衣城市道路广告视觉" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="eager" /></div><div class="work-card__copy"><span class="work-number">01 / Automotive Wrap Visual</span><h3>热门车型车衣视觉提案</h3><p>围绕 SU7、海豹、Taycan 等车型，展示二次元、国潮、赛博和运动方向的车衣广告视觉。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<a class="work-card work-card--wide" href="/work/aster-dew-skincare/"><div class="work-card__visual"><Image src={skincareCard} alt="Aster Dew 护肤精华与纸盒的横版品牌视觉" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="lazy" /></div><div class="work-card__copy"><span class="work-number">02 / Beauty Commerce Visual</span><h3>Aster Dew：护肤商品视觉</h3><p>同一产品从主图、材质细节到生活方式与详情页模块的完整视觉组。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<a class="work-card work-card--wide" href="/work/zhaoshuang/"><div class="work-card__visual"><Image src={zhaoshuangSystem} alt="赵霜原创角色的四视图、表情与道具设定系统" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="lazy" /></div><div class="work-card__copy"><span class="work-number">03 / Character Design System</span><h3>赵霜：把识别度写进设定</h3><p>用四视图、表情与道具建立角色锚点，为分镜、动作和系列画面提供一致性基线。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<a class="work-card" href="/work/open-ear-headphones/"><div class="work-card__visual"><Image src={openEarHero} alt="AURALINK ARC 开放式耳挂耳机商品主图" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="lazy" /></div><div class="work-card__copy"><span class="work-number">04 / 3C Commerce Visual</span><h3>开放式耳机：商品视觉链路</h3><p>从产品多视角基准、白底主图到收纳与桌面场景，展示跨图一致性与页面职责。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<a class="work-card" href="/work/nova/"><div class="work-card__visual"><Image src={novaMerchSystem} alt="NOVA 原创角色与谷子商品系统" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="lazy" /></div><div class="work-card__copy"><span class="work-number">05 / Original IP Extension</span><h3>NOVA：从角色到商品系统</h3><p>将角色锚点延展为主视觉、周边载体、包装候选与陈列提案，保持系列识别。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<a class="work-card work-card--ultrawide" href="/work/cosplay-retouch/"><div class="work-card__visual"><Image src={cosplayComparison} alt="人像修图的通过、拒绝与修正版对比" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="lazy" /></div><div class="work-card__copy"><span class="work-number">06 / Retouch &amp; Visual QA</span><h3>精修与画面质量控制</h3><p>保留问题判断、修正方向与验收结果，说明候选图如何进入可交付的最终画面。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<a class="work-card work-card--wide" href="/work/moonlit-tea/"><div class="work-card__visual"><Image src={moonlitTeaCover} alt="月蚀茶局角色与品牌横版设定图" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="lazy" /></div><div class="work-card__copy"><span class="work-number">07 / Brand &amp; Packaging</span><h3>月蚀茶局：品牌与包装提案</h3><p>从品牌方向、SKU 层级到礼册与包装结构，展示一组完整的商品视觉延展。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<a class="work-card" href="/work/whisky-port/"><div class="work-card__visual"><Image src={whiskyPort} alt="威士忌港品牌场景海报" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="lazy" /></div><div class="work-card__copy"><span class="work-number">08 / Label &amp; Packaging</span><h3>威士忌港：酒标与品牌场景</h3><p>从酒标设计稿延展到品牌场景海报，展示平面语言、信息层级与氛围的统一。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
	</div></section>
</PortfolioLayout>
