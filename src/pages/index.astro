---
import { Image } from "astro:assets";
import baijinKeyVisual from "@/assets/images/portfolio/baijin-key-visual.png";
import contentOpsCard from "@/assets/images/portfolio/content-ops-card.jpg";
import novaKeyVisual from "@/assets/images/portfolio/nova-key-visual.png";
import novaMerchSystem from "@/assets/images/portfolio/nova-merch-system.png";
import profileAvatar from "@/assets/images/portfolio/profile-avatar.png";
import shortVideoCard from "@/assets/images/portfolio/short-video-card.jpg";
import trueyouCard from "@/assets/images/portfolio/trueyou-card.jpg";
import cosplayDirectionComparison from "@/assets/images/portfolio/cosplay-retouch-direction-comparison.png";
import zhaoshuangSystem from "@/assets/images/portfolio/zhaoshuang-character-system.png";
import SystemProjectCard from "@/components/SystemProjectCard.astro";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="NOVA" description="NOVA 的二次元视觉设计、原创 IP、AI 图片生产与创意系统实践。" ogImage={novaKeyVisual.src}>
	<section class="hero site-shell">
		<div class="hero__intro">
			<div><p class="eyebrow">NOVA / Visual Design Portfolio</p><h1 class="display-title"><span>让角色成为</span><span class="display-title__accent">一套世界。</span></h1></div>
			<div class="hero__aside"><p>围绕二次元角色视觉、原创 IP、AI 图片生产与创意系统建设。从角色锚点到主视觉、周边与陈列，建立可延展、可识别的视觉表达。</p><a class="text-link" href="/work/">浏览完整作品 <span>↗</span></a></div>
		</div>
		<div class="hero__visual"><Image src={novaKeyVisual} alt="原创 IP NOVA 的角色主视觉" widths={[720, 1200, 1600]} sizes="(max-width: 900px) 100vw, 1240px" loading="eager" /><span class="hero__index">FEATURED / 01 — NOVA FRAME SHIFT</span></div>
	</section>

	<section class="section"><div class="site-shell">
		<div class="section-heading"><div><p class="eyebrow">Selected Work / 2026</p><h2 class="section-title">作品先说话，方法随后。</h2></div><p class="section-heading__note">以下案例均使用原创或权属清楚的素材，并区分现有产物、设计判断与仍在完善的部分。</p></div>
		<div class="work-list">
			<a class="work-card" href="/work/nova/"><div class="work-card__visual"><Image src={novaMerchSystem} alt="NOVA 角色及谷子周边系统" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="eager" /></div><div class="work-card__copy"><span class="work-number">01 / Original IP System</span><h3>NOVA：从角色到商品系统</h3><p>以统一锚点串联角色主视觉、徽章、立牌、卡牌、包装和陈列。</p><span class="work-arrow">VIEW CASE ↗</span></div></a>
			<a class="work-card work-card--portrait" href="/work/baijin/"><div class="work-card__visual"><Image src={baijinKeyVisual} alt="原创角色白烬的雪地科幻主视觉" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="eager" /></div><div class="work-card__copy"><span class="work-number">02 / Character Key Visual</span><h3>白烬：用环境完成角色叙事</h3><p>通过服装、机械配件、冷色环境和视觉焦点建立清晰的角色气质。</p><span class="work-arrow">VIEW CASE ↗</span></div></a>
			<a class="work-card" href="/work/zhaoshuang/"><div class="work-card__visual"><Image src={zhaoshuangSystem} alt="原创角色赵霜的角色设定系统" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="eager" /></div><div class="work-card__copy"><span class="work-number">03 / Character Bible</span><h3>赵霜：把识别度写进设定</h3><p>用四视图、表情、道具与配色构建可被持续复用的角色说明书。</p><span class="work-arrow">VIEW CASE ↗</span></div></a>
		</div>
	</div></section>

	<section class="section"><div class="site-shell">
		<div class="section-heading"><div><p class="eyebrow">Practice / Research</p><h2 class="section-title">把复杂工作，变成看得懂的流程。</h2></div><p class="section-heading__note">这里记录图片生产、内容运营与短视频制作中的方法实践；已完成案例、可用原型与研究预演分别标注。</p></div>
		<div class="system-project-grid">
			<SystemProjectCard tag="04 / Content Operations" title="AI 内容运营系统" status="实践原型" stage={3} image={contentOpsCard} imageAlt="AI 内容运营系统质量演示板" href="/work/content-operations/" description="从选题到复盘，把内容生产变成一条可追踪的工作链。" steps={["发现", "组织", "检查", "复盘"]} />
			<SystemProjectCard tag="05 / Short Video Workflow" title="AI 短视频制作流程" status="镜头预研" stage={2} image={shortVideoCard} imageAlt="短片镜头预演联系表" href="/work/video-workflow/" description="把镜头、节奏、连续性和交付拆成可检查的步骤。" steps={["故事", "镜头", "检查", "交付"]} />
			<SystemProjectCard tag="06 / TrueYou Studio" title="TrueYou Studio：图片生产与质检" status="本地案例" stage={3} image={trueyouCard} imageAlt="TrueYou Studio 图片生产台系统总览" href="/work/trueyou-studio/" description="把素材、方案、生成、质检和交付组织成一套可复核的图片生产流程。" steps={["素材", "方案", "质检", "交付"]} />
			<SystemProjectCard tag="07 / Portrait Retouch" title="Cosplay Portrait Retouch：定向修图" status="方法案例" stage={3} image={cosplayDirectionComparison} imageAlt="Cosplay 人像修图的通过、拒绝与修正版对比" href="/work/cosplay-retouch/" description="用对比板记录问题、拒绝原因和局部修正，让审美判断可以被复盘。" steps={["发现问题", "拒绝", "修正", "验收"]} />
			<SystemProjectCard tag="08 / Q-Scry" title="Q-Scry：AI 情报与机会雷达" status="本地系统" stage={3} href="/work/qscry/" description="把高噪声信息压缩成带来源、可核查、可决定的信号。" steps={["采集", "压缩", "核查", "决策"]} />
		</div>
	</div></section>

	<section class="section"><div class="site-shell">
		<div class="section-heading"><div><p class="eyebrow">Capability</p><h2 class="section-title">一套完整视觉，而不是一张偶然好图。</h2></div><p class="section-heading__note">工具参与生成与迭代，但最终呈现由明确的设计约束、筛选标准与人工判断负责。</p></div>
		<div class="capability-grid">
			<div class="capability"><span class="capability-index">01</span><h3>角色锚点</h3><p>身份、轮廓、服装、配件、表情与配色保持统一。</p></div>
			<div class="capability"><span class="capability-index">02</span><h3>主视觉叙事</h3><p>用构图、环境、材质和光线完成角色气质的表达。</p></div>
			<div class="capability"><span class="capability-index">03</span><h3>商品化延展</h3><p>让角色进入徽章、立牌、卡牌、包装与陈列场景。</p></div>
			<div class="capability"><span class="capability-index">04</span><h3>视觉质检</h3><p>记录问题、拒绝原因和修正方向，控制一致性与可用性。</p></div>
		</div>
	</div></section>

	<section class="dark-section"><div class="site-shell dark-section__grid">
		<div class="dark-section__copy"><p class="eyebrow">Current Research</p><h2 class="section-title">把创作判断变成可复盘的方法。</h2><p>研究不用于堆砌概念，而用于提升下一次创作的稳定性、连续性与交付清晰度。</p><a class="text-link" href="/about/#research">查看方法与研究边界 <span>↗</span></a></div>
		<div class="research-list">
			<div class="research-item"><span>01</span><div><strong>数字短片前期</strong><p>镜头设计、节奏预演与角色连续性。</p></div></div>
			<div class="research-item"><span>02</span><div><strong>角色一致性与视觉 QA</strong><p>识别比例、材质、手部、文字和融合问题。</p></div></div>
			<div class="research-item"><span>03</span><div><strong>创意资产与内容系统</strong><p>让选题、视觉资产、审核与复盘保持可追溯。</p></div></div>
			<div class="research-item"><span>04</span><div><strong>人机协作边界</strong><p>工具负责放大探索，人工负责审美判断与最终责任。</p></div></div>
		</div>
	</div></section>

	<section class="section"><div class="site-shell about-profile">
		<div class="about-profile__image"><Image src={profileAvatar} alt="NOVA 个人头像" width={802} height={804} /></div>
		<div class="about-profile__copy"><p class="eyebrow">About NOVA</p><h2 class="section-title">设计一眼可见，判断经得起追问。</h2><p>这个网站长期记录原创 IP、二次元视觉与商品化方向的公开作品。每个案例尽量说明范围、过程和边界，不以虚构数据或未确认成果替代真实能力。</p><a class="text-link" href="/about/">关于、方法与联系 <span>↗</span></a></div>
	</div></section>
</PortfolioLayout>
