---
import { Image } from "astro:assets";
import baijinKeyVisual from "@/assets/images/portfolio/baijin-key-visual.webp";
import novaKeyVisual from "@/assets/images/portfolio/nova-key-visual.webp";
import noonOverview from "@/assets/images/portfolio/noon-pilgrimage-overview.webp";
import redTideOverview from "@/assets/images/portfolio/red-tide-overview.webp";
import weekEightOverview from "@/assets/images/portfolio/week-eight-overview.webp";
import moonlitTeaCover from "@/assets/images/portfolio/moonlit-tea-cover.webp";
import repairProductSystem from "@/assets/images/portfolio/products/repair-product-system.webp";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="原创 IP 作品总览" description="白烬、帧隙信使、无昼巡礼、赤潮信标、星期八便利店、月蚀茶局与街区修补社的原创 IP 完整链路总览。" ogImage={baijinKeyVisual.src}>
	<header class="project-hero site-shell"><p class="project-kicker">Original IP Studio / Portfolio Map</p><h1 class="project-title">把原创 IP 做成可以持续生产的系统。</h1><p class="project-lead">从角色设定、世界规则、剧情场景到商品、包装、源文件和 QA，集中展示当前原创项目的完整链路。每个项目都能单独阅读，也能作为不同岗位的组合案例。</p><div class="project-meta"><div><span class="meta-label">Projects</span><strong>7 组原创 IP</strong></div><div><span class="meta-label">Evidence</span><strong>角色 / 场景 / 商品 / 源文件</strong></div><div><span class="meta-label">Tools</span><strong>Photoshop / Illustrator / GPT Image</strong></div><div><span class="meta-label">Status</span><strong>概念与生产候选分开</strong></div></div></header>

	<section class="site-shell case-section"><div><p class="eyebrow">01 / Character-led IP</p><h2>以角色为核心的三组世界。</h2></div><div class="case-body"><div class="detail-gallery"><figure><Image src={baijinKeyVisual} alt="白烬原创 IP 角色主视觉" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="eager" /><figcaption><b>白烬 / 灰庭城</b><span>科幻角色、多人关系、剧情关键帧与商品延展。</span><a class="text-link" href="/work/baijin-ensemble/">角色关系设定 ↗</a></figcaption></figure><figure><Image src={novaKeyVisual} alt="帧隙信使原创 IP 林澈主视觉" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>帧隙信使 / 栖光市</b><span>角色四视图、地铁任务、近景情绪与周边系统。</span><a class="text-link" href="/work/nova-scene-design/">场景任务案例 ↗</a></figcaption></figure><figure><Image src={noonOverview} alt="无昼巡礼原创 IP 总览" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>无昼巡礼 / 时间失序</b><span>照霜角色、日标规则、归灯站与金属书签候选。</span><a class="text-link" href="/work/noon-pilgrimage/">查看完整项目 ↗</a></figcaption></figure></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">02 / World &amp; Product IP</p><h2>世界观可以继续变成产品。</h2></div><div class="case-body"><div class="detail-gallery"><figure><Image src={redTideOverview} alt="赤潮信标原创 IP 总览" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>赤潮信标 / 深海环礁</b><span>雾灯、信标链、维护装备、胸针与收藏卡候选。</span><a class="text-link" href="/work/red-tide-beacon/">查看完整项目 ↗</a></figcaption></figure><figure><Image src={weekEightOverview} alt="星期八便利店原创 IP 总览" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>星期八便利店 / 日常奇幻</b><span>唐小满、门店陈列、盲盒包装与商品层级。</span><a class="text-link" href="/work/week-eight/">查看完整项目 ↗</a></figcaption></figure><figure><Image src={moonlitTeaCover} alt="月蚀茶局原创品牌 IP 总览" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>月蚀茶局 / 夜游茶饮</b><span>绛雪、品牌世界、SKU、包装刀模和门店陈列。</span><a class="text-link" href="/work/moonlit-tea/">查看完整项目 ↗</a></figcaption></figure><figure><Image src={repairProductSystem} alt="街区修补社原创机能产品 IP 总览" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>街区修补社 / 机能生活</b><span>柚铁、维修网络、工具、服装与亚克力生产候选。</span><a class="text-link" href="/work/street-repair/">查看完整项目 ↗</a></figcaption></figure></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">03 / Production Spine</p><h2>每组 IP 都沿同一条生产脊柱推进。</h2></div><div class="case-body"><div class="system-map"><div class="system-node system-node--acid"><span>01 / CHARACTER</span><strong>角色锚点</strong></div><div class="system-node"><span>02 / WORLD</span><strong>世界规则</strong></div><div class="system-node system-node--ice"><span>03 / OUTPUT</span><strong>场景 / 商品</strong></div><div class="system-node"><span>04 / SOURCE</span><strong>源文件 / QA</strong></div></div><p style="margin-top:1.5rem">项目之间共享流程，但不共享角色内容：设定、提示词、候选、后期、源文件和生产边界分别记录，避免原创 IP 变成只有一张主视觉的展示。</p><a class="text-link" href="/work/aigc-draft-library/">查看 AIGC 初稿与筛选库 <span>↗</span></a> <a class="text-link" href="/work/source-file-index/">查看源文件索引 <span>↗</span></a></div></section>
</PortfolioLayout>
