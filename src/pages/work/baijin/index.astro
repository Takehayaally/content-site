---
import { Image } from "astro:assets";
import baijinKeyVisual from "@/assets/images/portfolio/baijin-key-visual.png";
import baijinDetailFace from "@/assets/images/portfolio/baijin-detail-face.jpg";
import baijinDetailMaterial from "@/assets/images/portfolio/baijin-detail-material.jpg";
import baijinDetailWorld from "@/assets/images/portfolio/baijin-detail-world.jpg";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import ProjectSwitcher from "@/components/ProjectSwitcher.astro";
---

<PortfolioLayout title="白烬：用环境完成角色叙事" description="原创角色白烬的雪地科幻主视觉与角色叙事设计。" ogImage={baijinKeyVisual.src}>
	<ProjectSwitcher current="baijin" />
	<header class="project-hero site-shell"><p class="project-kicker">Case 02 / Character Key Visual</p><h1 class="project-title">白烬：用环境完成角色叙事</h1><p class="project-lead">角色不是贴在背景上的立绘。服装、机械结构、雪地环境和冷光共同建立她所在的世界与行动状态。</p><div class="project-meta"><div><span class="meta-label">Scope</span><strong>角色主视觉</strong></div><div><span class="meta-label">Focus</span><strong>构图 / 氛围 / 视觉焦点</strong></div><div><span class="meta-label">Output</span><strong>竖版关键视觉</strong></div><div><span class="meta-label">Status</span><strong>原创公开案例</strong></div></div></header>
	<div class="project-cover project-cover--portrait"><Image src={baijinKeyVisual} alt="白烬在雪地科幻环境中的完整主视觉" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" /></div>

	<section class="site-shell case-section"><div><p class="eyebrow">01 / Direction</p><h2>把冷感、重量与行动性放在同一画面。</h2></div><div class="case-body"><p>画面以低饱和雪地和机械结构建立冷感，再以角色的深色服装、发色与近景比例形成清晰焦点。环境不是装饰，而是解释角色所处的危险与技术语境。</p><ul class="case-points"><li><span>01</span><div><strong>前中后景建立纵深</strong><br />雪地碎片、角色与远景设施形成连续空间。</div></li><li><span>02</span><div><strong>机械配件延续世界观</strong><br />装备的硬结构与服装柔性材质形成张力。</div></li><li><span>03</span><div><strong>控制冷色里的明度节奏</strong><br />亮雪、暗服装和局部冷光让视线先到角色再阅读环境。</div></li></ul></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">02 / Visual Logic</p><h2>一张主视觉的阅读顺序。</h2></div><div class="case-body"><div class="system-map"><div class="system-node system-node--ice"><span>01 / SIGNAL</span><strong>角色面部</strong></div><div class="system-node"><span>02 / FORM</span><strong>服装轮廓</strong></div><div class="system-node system-node--acid"><span>03 / CONTEXT</span><strong>机械装备</strong></div><div class="system-node"><span>04 / WORLD</span><strong>雪地环境</strong></div></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">03 / Evidence</p><h2>局部也要服从整体叙事。</h2></div><div class="case-body"><div class="detail-gallery"><figure><Image src={baijinDetailFace} alt="白烬面部与发型视觉焦点" widths={[640, 960]} sizes="(max-width: 620px) 100vw, 33vw" /><figcaption><b>视觉焦点</b><span>脸部与发型承担第一识别层，不被环境高光抢走。</span></figcaption></figure><figure><Image src={baijinDetailMaterial} alt="白烬服装与机械装备细节" widths={[640, 960]} sizes="(max-width: 620px) 100vw, 33vw" /><figcaption><b>材质关系</b><span>柔性服装和硬质机械形成角色的行动张力。</span></figcaption></figure><figure><Image src={baijinDetailWorld} alt="白烬雪地环境与空间层次" widths={[640, 960]} sizes="(max-width: 620px) 100vw, 33vw" /><figcaption><b>空间叙事</b><span>雪地与设施提供尺度、危险和世界背景。</span></figcaption></figure></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">04 / Review</p><h2>主视觉之后，需要系统化补全。</h2></div><div class="case-body"><p>当前案例能证明角色气质与叙事主视觉的组织能力，但不把单张 KV 包装成完整 IP 系统。后续若继续发展，应补齐稳定设定、表情与动作、关键装备拆解和跨场景一致性。</p></div></section>
</PortfolioLayout>
