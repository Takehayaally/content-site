---
import { Image } from "astro:assets";
import firefly from "@/assets/images/portfolio/auto-wrap-su7-firefly.png";
import guochao from "@/assets/images/portfolio/auto-wrap-byd-seal-guochao.png";
import motorsport from "@/assets/images/portfolio/auto-wrap-taycan-motorsport.png";
import miku from "@/assets/images/portfolio/auto-wrap-model-y-miku.png";
import zeekr from "@/assets/images/portfolio/auto-wrap-zeekr-cyber.png";
import bmw from "@/assets/images/portfolio/auto-wrap-bmw-retro.png";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---
<PortfolioLayout title="热门车型车衣视觉提案" description="热门车型车衣与广告场景视觉项目。" ogImage={firefly.src}>
	<header class="project-hero site-shell"><p class="project-kicker">Case / Automotive Wrap Collection</p><h1 class="project-title">热门车型车衣视觉提案</h1><p class="project-lead">围绕紧凑纯电、城市 SUV 与运动型轿车，整理二次元痛车、国潮商业和国际运动三组车衣方向，并延展到真实道路广告场景。</p><div class="project-meta"><div><span class="meta-label">Scope</span><strong>车型视觉 / 车衣设计 / 广告 KV</strong></div><div><span class="meta-label">Collection</span><strong>二次元 / 国潮 / 运动</strong></div><div><span class="meta-label">Output</span><strong>多视图 / 车身方案 / 场景图</strong></div><div><span class="meta-label">Models</span><strong>SU7 / 海豹 / Taycan</strong></div></div></header>
	<figure class="case-full-visual case-full-visual--bleed"><a class="image-lightbox-link" href={firefly.src} target="_blank" rel="noreferrer"><Image src={firefly} alt="小米 SU7 流萤主题二次元车衣行驶在城市道路" widths={[800,1400,2000]} sizes="100vw" loading="eager" /></a><figcaption>SU7 × 流萤 / 城市夜景广告质感</figcaption></figure>
	<section class="site-shell case-section"><div><p class="eyebrow">03 / Style Direction</p><h2>国潮图形与城市地标。</h2></div><div class="case-body"><figure class="case-full-visual case-full-visual--compact"><a class="image-lightbox-link" href={guochao.src} target="_blank" rel="noreferrer"><Image src={guochao} alt="比亚迪海豹国潮红黑金车衣在城市道路上的广告画面" widths={[800,1400,2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>BYD Seal × 国潮山海 / 城市日落广告场景</figcaption></figure></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">04 / Style Direction</p><h2>赛道语言与高级运动感。</h2></div><div class="case-body"><figure class="case-full-visual case-full-visual--compact"><a class="image-lightbox-link" href={motorsport.src} target="_blank" rel="noreferrer"><Image src={motorsport} alt="保时捷 Taycan 国际运动风车衣在雪山道路上的广告画面" widths={[800,1400,2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>Taycan × European Motorsport / 山地公路广告场景</figcaption></figure></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">04A / Extended Collection</p><h2>从东京夜路到上海滨江，再到地中海公路。</h2></div><div class="case-body"><div class="visual-wall"><figure><a class="image-lightbox-link" href={miku.src} target="_blank" rel="noreferrer"><Image src={miku} alt="Tesla Model Y 初音未来主题车衣在东京夜间道路" widths={[800,1400,2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>MODEL Y × MIKU / DIGITAL ITASHA</figcaption></figure><figure><a class="image-lightbox-link" href={zeekr.src} target="_blank" rel="noreferrer"><Image src={zeekr} alt="极氪 001 赛博书法车衣在上海滨江道路" widths={[800,1400,2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>ZEEKR 001 × CYBER CALLIGRAPHY</figcaption></figure><figure><a class="image-lightbox-link" href={bmw.src} target="_blank" rel="noreferrer"><Image src={bmw} alt="BMW M4 复古房车赛风格车衣在地中海沿岸公路" widths={[800,1400,2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>BMW M4 × RETRO TOURING CAR</figcaption></figure></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">05 / Collection</p><h2>车型、车衣与场景组成完整提案。</h2></div><div class="case-body"><p>六组核心方案覆盖二次元痛车、国潮、赛博书法、运动与复古房车赛方向，可延展为车展静态展示、道路广告与社媒封面。</p></div></section>
</PortfolioLayout>
