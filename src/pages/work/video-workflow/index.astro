---
import { Image } from "astro:assets";
import shortVideoCard from "@/assets/images/portfolio/short-video-card.jpg";
import shortVideoDetailEnding from "@/assets/images/portfolio/short-video-detail-ending.jpg";
import shortVideoDetailMiddle from "@/assets/images/portfolio/short-video-detail-middle.jpg";
import shortVideoDetailOpening from "@/assets/images/portfolio/short-video-detail-opening.jpg";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="AI 短视频制作流程" description="从故事卡、镜头预演和连续性检查，到正式制作前的可验证短视频工作流。" ogImage={shortVideoCard.src}>
	<header class="project-hero site-shell"><p class="project-kicker">Case 05 / Short Video Workflow</p><h1 class="project-title">先把镜头想清楚，再把成本花出去</h1><p class="project-lead">这个项目把短视频拆成故事、节奏、逐镜画面、连续性和交付检查，让问题尽量在正式生成和剪辑前暴露。</p><div class="project-meta"><div><span class="meta-label">Problem</span><strong>返工晚、成本不可控</strong></div><div><span class="meta-label">Role</span><strong>流程设计 / 视觉预演</strong></div><div><span class="meta-label">Output</span><strong>故事卡 / 预演 / QC</strong></div><div><span class="meta-label">Status</span><strong>初步构建 / 研究</strong></div></div></header>
	<figure class="case-full-visual case-full-visual--wide"><Image src={shortVideoCard} alt="短视频镜头预演的开场、转折与结尾联系表" widths={[720, 1200]} sizes="(max-width: 900px) 100vw, 1240px" loading="eager" /><figcaption>研究阶段的镜头预演：先检查开场、转折和结尾的画面关系，不把预演包装成最终成片。</figcaption></figure>
	<section class="case-section site-shell"><h2>逐段检查，而不是只看缩略图</h2><div class="case-body"><div class="detail-gallery"><figure><Image src={shortVideoDetailOpening} alt="短视频开场镜头预演局部" widths={[640, 960]} sizes="(max-width: 620px) 100vw, 33vw" /><figcaption><b>开场信息</b><span>第一组镜头先交代空间、角色和视觉锚点。</span></figcaption></figure><figure><Image src={shortVideoDetailMiddle} alt="短视频转折镜头预演局部" widths={[640, 960]} sizes="(max-width: 620px) 100vw, 33vw" /><figcaption><b>转折节奏</b><span>中段检查动作方向、景别变化和叙事推进。</span></figcaption></figure><figure><Image src={shortVideoDetailEnding} alt="短视频结尾镜头预演局部" widths={[640, 960]} sizes="(max-width: 620px) 100vw, 33vw" /><figcaption><b>结尾回收</b><span>最后确认光线、角色状态和视觉重点是否回收。</span></figcaption></figure></div></div></section>
	<section class="case-section site-shell"><h2>为什么先做预演</h2><div class="case-body"><p>正式生图、生视频和配音都可能产生费用。先用低成本预演确认镜头关系，可以提前发现叙事不清、角色跳变和节奏拖沓。</p><ul class="case-points"><li><span>01</span><strong>先验证故事是否看得懂</strong></li><li><span>02</span><strong>再检查角色和视觉锚点是否连续</strong></li><li><span>03</span><strong>通过后才进入正式素材生产</strong></li></ul></div></section>
	<section class="case-section site-shell"><h2>当前边界</h2><div class="case-body"><p>当前已有故事卡、静态关键帧、节奏预演和检查流程。正式素材、声音和最终成片仍在独立项目中推进，因此这里不把研究预演包装成完成作品。</p><div class="system-map"><div class="system-node system-node--acid"><span>01 / DONE</span><strong>思路定义</strong></div><div class="system-node system-node--ice"><span>02 / NOW</span><strong>初步构建</strong></div><div class="system-node"><span>03 / NEXT</span><strong>系统建设</strong></div><div class="system-node"><span>04 / NEXT</span><strong>公开交付</strong></div></div></div></section>
</PortfolioLayout>
