---
import { Image } from "astro:assets";
import baijinKeyVisual from "@/assets/images/portfolio/baijin-key-visual.png";
import novaMerchSystem from "@/assets/images/portfolio/nova-merch-system.png";
import zhaoshuangSystem from "@/assets/images/portfolio/zhaoshuang-character-system.png";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="作品" description="NOVA 的原创 IP、角色视觉、主视觉与商品化表达案例。" ogImage={novaMerchSystem.src}>
	<header class="page-hero site-shell"><div class="page-hero__grid">
		<div><p class="eyebrow">Selected Work / Archive</p><h1 class="page-title">从角色识别，到完整视觉系统。</h1></div>
		<p class="page-summary">作品按角色系统、主视觉叙事与设定说明组织。进入案例可查看设计目标、关键判断、系统结构与公开边界。</p>
	</div></header>

	<section class="section"><div class="site-shell work-list">
		<a class="work-card" href="/work/nova/"><div class="work-card__visual"><Image src={novaMerchSystem} alt="NOVA 原创 IP 与谷子商品系统" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="eager" /></div><div class="work-card__copy"><span class="work-number">01 / Original IP System</span><h3>NOVA：从角色到商品系统</h3><p>角色锚点、主视觉、周边载体、包装和陈列形成统一系列。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<a class="work-card work-card--portrait" href="/work/baijin/"><div class="work-card__visual"><Image src={baijinKeyVisual} alt="白烬原创角色主视觉" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="eager" /></div><div class="work-card__copy"><span class="work-number">02 / Character Key Visual</span><h3>白烬：用环境完成角色叙事</h3><p>服装、机械结构、环境与光线共同强化角色的冷感和行动张力。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<a class="work-card" href="/work/zhaoshuang/"><div class="work-card__visual"><Image src={zhaoshuangSystem} alt="赵霜原创角色设定系统" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 75vw" loading="eager" /></div><div class="work-card__copy"><span class="work-number">03 / Character Bible</span><h3>赵霜：把识别度写进设定</h3><p>从四视图到表情、道具和视觉锚点，建立可复用的角色说明书。</p><span class="work-arrow">OPEN CASE ↗</span></div></a>
		<div class="reserved-card">
			<div><p class="eyebrow">Next / Reserved</p><h3>下一套完整案例，正在整理。</h3><p>为后续正式作品包预留的独立位置。只有在内容、权属、说明与视觉资产全部冻结后才会公开，不展示内部路径或未确认中间稿。</p></div>
			<div class="reserved-card__mark">CASE 04<br />RESERVED / NOT PUBLIC</div>
		</div>
	</div></section>
</PortfolioLayout>
