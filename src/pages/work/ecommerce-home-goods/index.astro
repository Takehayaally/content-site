---
import { Image } from "astro:assets";
import hammerBanner from "@/assets/images/portfolio/products/hardware-hammer-banner-fixed.webp";
import hammerDetail from "@/assets/images/portfolio/products/hardware-hammer-detail.webp";
import hammerHero from "@/assets/images/portfolio/products/hardware-hammer-hero.webp";
import hammerLong from "@/assets/images/portfolio/products/hardware-hammer-long-fixed.webp";
import hammerScene from "@/assets/images/portfolio/products/hardware-hammer-scene-fixed.webp";
import hammerVariants from "@/assets/images/portfolio/products/hardware-hammer-variants-fixed.webp";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="五金电商：单品上新视觉组" description="以同一把维修锤为唯一产品锚点，展示白底主图、详情特写、使用场景、活动横幅、尺寸结构与配色变体。" ogImage={hammerHero.src}>
	<header class="project-hero site-shell"><p class="project-kicker">P2 / Hardware E-commerce</p><h1 class="project-title">一把维修锤，完成一套电商上新视觉。</h1><p class="project-lead">围绕深灰、黑色与安全橙建立单品识别，从白底主图延展至局部特写、家居维修场景、活动横幅、详情长图和配色变体。</p><div class="project-meta"><div><span class="meta-label">Product</span><strong>单品维修锤</strong></div><div><span class="meta-label">Scope</span><strong>主图 / 详情 / 活动图</strong></div><div><span class="meta-label">Output</span><strong>1:1 / 3:4 / 16:9</strong></div><div><span class="meta-label">Focus</span><strong>产品一致性</strong></div></div></header>

	<figure class="case-full-visual case-full-visual--compact"><a class="image-lightbox-link" href={hammerHero.src} target="_blank" rel="noreferrer"><Image src={hammerHero} alt="深灰黑橙维修锤白底电商主图" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 66vw" loading="eager" /></a><figcaption>01 / 白底主图：固定锤头轮廓、手柄比例、握把纹理和橙色识别环，作为其他画面的唯一母图。</figcaption></figure>

	<section class="site-shell case-section"><div><p class="eyebrow">01 / Detail &amp; Dimensions</p><h2>局部特写和尺寸结构，都必须还是同一件产品。</h2></div><div class="case-body"><figure class="case-full-visual case-full-visual--wide"><a class="image-lightbox-link" href={hammerDetail.src} target="_blank" rel="noreferrer"><Image src={hammerDetail} alt="同一把维修锤的正视、锤头特写、握把特写与尺寸结构图" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>详情板：完整正视、锤头连接、握把纹理与尺寸标线；数字参数留给真实商品资料。</figcaption></figure></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">02 / Lifestyle &amp; Campaign</p><h2>场景图解释用途，横幅图负责活动焦点。</h2></div><div class="case-body"><div class="visual-wall"><figure><a class="image-lightbox-link" href={hammerScene.src} target="_blank" rel="noreferrer"><Image src={hammerScene} alt="同一把维修锤置于家居木工工作台上的使用场景" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" /></a><figcaption><b>4:5 / LIFESTYLE</b><span>家居维修场景：产品仍为主角，上方保留卖点文案空间。</span></figcaption></figure><figure><a class="image-lightbox-link" href={hammerBanner.src} target="_blank" rel="noreferrer"><Image src={hammerBanner} alt="同一把维修锤的深蓝橙色活动横幅" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" /></a><figcaption><b>16:9 / CAMPAIGN</b><span>活动横幅：左侧预留标题、促销标签和按钮安全区。</span></figcaption></figure></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">03 / Long Detail Page</p><h2>长图按“认产品—看结构—进场景”组织。</h2></div><div class="case-body"><figure class="case-full-visual case-full-visual--screen"><a class="image-lightbox-link" href={hammerLong.src} target="_blank" rel="noreferrer"><Image src={hammerLong} alt="维修锤电商详情页长图" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>3:4 详情长图：白底主图、结构与材质特写、家居维修场景保持同一产品锚点。</figcaption></figure></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">04 / Variants &amp; Operations</p><h2>保持商品识别一致，延展多组运营配色。</h2></div><div class="case-body"><figure class="case-full-visual case-full-visual--wide"><a class="image-lightbox-link" href={hammerVariants.src} target="_blank" rel="noreferrer"><Image src={hammerVariants} alt="同一把维修锤的橙色、绿色和砖红色配色变体" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>配色变体：三张图保持相同的产品轮廓和构图，以识别色区分活动主题。</figcaption></figure><div class="delivery-grid" style="margin-top:1.5rem"><div class="delivery-card"><span>1:1</span><h3>列表主图</h3><p>白底居中，缩略图中快速识别品类和轮廓。</p></div><div class="delivery-card"><span>3:4</span><h3>详情首屏</h3><p>组合主图、材质、结构和使用场景。</p></div><div class="delivery-card"><span>16:9</span><h3>活动横幅</h3><p>产品置于一侧，另一侧保留运营文案安全区。</p></div></div></div></section>
</PortfolioLayout>
