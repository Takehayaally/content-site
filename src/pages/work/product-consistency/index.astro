---
import { Image } from "astro:assets";
import jobEvidenceQaBoundaries from "@/assets/images/portfolio/job-evidence-qa-boundaries.png";
import openEarHeadphonesCharging from "@/assets/images/portfolio/open-ear-headphones-charging.webp";
import openEarHeadphonesDetail from "@/assets/images/portfolio/open-ear-headphones-detail.webp";
import openEarHeadphonesHero from "@/assets/images/portfolio/open-ear-headphones-hero.webp";
import openEarHeadphonesWorn from "@/assets/images/portfolio/open-ear-headphones-worn.webp";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="产品一致性与跨图 QA" description="面向电商商品视觉的产品锚点、跨图一致性与质量验收案例。" ogImage={openEarHeadphonesHero.src}>
	<header class="project-hero site-shell">
		<p class="project-kicker">Case 05 / Product Consistency &amp; QA</p><h1 class="project-title">产品一致性与跨图 QA</h1>
		<p class="project-lead">用同一款开放式耳机说明：如何固定产品锚点、允许场景变化、拒绝结构漂移，并把检查结果交给详情页与后续文件。</p>
		<div class="project-meta"><div><span class="meta-label">Scope</span><strong>3C 商品图组 / 详情页</strong></div><div><span class="meta-label">Role</span><strong>产品定义 / 跨图复核 / QA</strong></div><div><span class="meta-label">Output</span><strong>锚点表 / 对比板 / 验收门</strong></div><div><span class="meta-label">Status</span><strong>个人概念练习 / 非真实上架</strong></div></div>
	</header>
	<figure class="case-full-visual case-full-visual--compact"><Image src={openEarHeadphonesHero} alt="开放式耳挂耳机白底主图作为产品一致性参考锚点" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="eager" /><figcaption>以通过审核的主图作为唯一参考锚点，再检查其他角度与场景是否仍是同一产品。</figcaption></figure>

	<section class="site-shell case-section"><div><p class="eyebrow">01 / Anchor Sheet</p><h2>先写清楚什么不能变。</h2></div><div class="case-body"><dl class="spec-table"><div><dt>形态</dt><dd>开放式耳挂，外露声学区，不得变成入耳式或头戴式。</dd></div><div><dt>材质</dt><dd>深石墨主体、银色过渡、柔和青绿色状态灯。</dd></div><div><dt>套装关系</dt><dd>左右耳机成对，充电盒为扁椭圆形，开盖与内托关系稳定。</dd></div></dl></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">02 / Comparison Set</p><h2>用图组而不是单图判断一致性。</h2></div><div class="case-body"><div class="detail-gallery"><figure><Image src={openEarHeadphonesDetail} alt="开放式耳机结构细节一致性检查" widths={[640, 960]} sizes="(max-width: 620px) 100vw, 33vw" /><figcaption><b>DETAIL</b><span>触控面、耳挂与材质边界。</span></figcaption></figure><figure><Image src={openEarHeadphonesCharging} alt="开放式耳机充电盒关系一致性检查" widths={[640, 960]} sizes="(max-width: 620px) 100vw, 33vw" /><figcaption><b>CHARGE</b><span>左右耳、内托与盒体关系。</span></figcaption></figure><figure><Image src={openEarHeadphonesWorn} alt="开放式耳机佩戴位置一致性检查" widths={[640, 960]} sizes="(max-width: 620px) 100vw, 33vw" /><figcaption><b>WEAR</b><span>耳挂在耳廓上的位置。</span></figcaption></figure></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">03 / QA Output</p><h2>把判断交付给下一步，而不是停在审美意见。</h2></div><div class="case-body"><div class="delivery-grid"><div class="delivery-card"><span>PASS</span><h3>结构通过</h3><p>产品轮廓、左右配对和材质边界保持稳定。</p></div><div class="delivery-card"><span>REJECT</span><h3>候选退回</h3><p>结构漂移、错误品类或伪造文字直接拒绝。</p></div><div class="delivery-card"><span>HANDOFF</span><h3>进入页面</h3><p>通过图再进入详情页模块、裁切与文件归档。</p></div></div><figure class="case-full-visual case-full-visual--screen" style="margin-top:1.5rem;padding:1rem"><Image src={jobEvidenceQaBoundaries} alt="商品视觉质量检查与边界示例" widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /><figcaption>公开展示的是 QA 方法与边界，不提供内部原始提示词、缓存或未采用候选。</figcaption></figure></div></section>
</PortfolioLayout>
