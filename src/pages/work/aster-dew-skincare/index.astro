---
import { Image } from "astro:assets";
import hero from "@/assets/images/portfolio/aster-dew-hero.webp";
import detail from "@/assets/images/portfolio/aster-dew-detail.webp";
import lifestyle from "@/assets/images/portfolio/aster-dew-lifestyle.webp";
import flatlay from "@/assets/images/portfolio/aster-dew-flatlay.webp";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="Aster Dew：护肤品商品视觉" description="从产品锚点到广告 KV、详情页和场景图的护肤品商品视觉整组案例。" ogImage={hero.src}>
	<header class="project-hero site-shell"><p class="project-kicker">Case 08 / Beauty Commerce Visual</p><h1 class="project-title">Aster Dew：<br />一支精华的整组商品视觉。</h1><p class="project-lead">围绕同一支虚构植物精华，完成商品主图、材质细节、生活方式场景、平铺组合和详情页模块规划。</p><div class="project-meta"><div><span class="meta-label">Scope</span><strong>主图 / 场景 / 详情页</strong></div><div><span class="meta-label">Role</span><strong>产品锚点 / 视觉编排 / QA</strong></div><div><span class="meta-label">Output</span><strong>Hero / Detail / Lifestyle / Flatlay</strong></div><div><span class="meta-label">Status</span><strong>个人商品视觉案例</strong></div></div></header>
	<figure class="case-full-visual case-full-visual--compact"><a class="image-lightbox-link" href={hero.src} target="_blank" rel="noreferrer"><Image src={hero} alt="Aster Dew 植物精华护肤品主视觉" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="eager" /></a><figcaption>产品主锚点：磨砂浅绿色玻璃瓶、奶油色滴管盖、留白标签。</figcaption></figure>
	<section class="site-shell case-section"><div><p class="eyebrow">01 / Product Anchor</p><h2>先把同一支产品固定下来。</h2></div><div class="case-body"><p>所有画面固定瓶身比例、浅绿色磨砂玻璃、奶油色滴管盖、空白标签和圆角轮廓，只改变镜头、道具、光线与使用语境。</p><div class="consistency-matrix"><div><b>固定</b><span>瓶型、盖型、主色、标签位置</span><span>所有主图与场景图必须保留</span></div><div><b>可变</b><span>石材、浴室、叶片、俯拍角度</span><span>只改变氛围，不改变产品</span></div><div><b>拒绝</b><span>瓶身变形、盖子更换、标签乱码</span><span>直接退回候选，不用文字掩盖</span></div></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">02 / Visual Set</p><h2>四张图，四个页面职责。</h2></div><div class="case-body"><div class="visual-wall"><figure><a class="image-lightbox-link" href={detail.src} target="_blank" rel="noreferrer"><Image src={detail} alt="Aster Dew 精华瓶材质细节" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption><strong>DETAIL</strong><span>材质、滴管与水珠细节</span></figcaption></figure><figure><a class="image-lightbox-link" href={lifestyle.src} target="_blank" rel="noreferrer"><Image src={lifestyle} alt="Aster Dew 精华浴室生活方式场景" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption><strong>LIFESTYLE</strong><span>浴室与晨光使用情境</span></figcaption></figure><figure><a class="image-lightbox-link" href={flatlay.src} target="_blank" rel="noreferrer"><Image src={flatlay} alt="Aster Dew 精华三瓶俯拍组合" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption><strong>FLATLAY</strong><span>组合、套装和社媒构图</span></figcaption></figure></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">03 / Commerce Modules</p><h2>从图像直接落到详情页。</h2></div><div class="case-body"><div class="delivery-grid"><div class="delivery-card"><span>01 / HERO</span><h3>首屏识别</h3><p>单瓶、留白、瓶型清楚，负责第一眼识别与后置标题。</p></div><div class="delivery-card"><span>02 / PROOF</span><h3>材质细节</h3><p>水珠、磨砂玻璃和滴管结构承担局部视觉说明。</p></div><div class="delivery-card"><span>03 / CONTEXT</span><h3>使用场景</h3><p>浴室晨光与植物道具补充生活方式，不虚构功效。</p></div><div class="delivery-card"><span>04 / SOCIAL</span><h3>社媒平铺</h3><p>三瓶组合与俯拍留白适合社媒首图和活动 KV 延展。</p></div></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">04 / Handoff</p><h2>把源文件和事实边界一起交出去。</h2></div><div class="case-body"><dl class="spec-table"><div><dt>图像包</dt><dd>主图、细节、场景、平铺四类导出，保留命名与页面职责。</dd></div><div><dt>后期项</dt><dd>裁切、标签留白、反射控制、色彩统一与安全区检查。</dd></div><div><dt>待确认</dt><dd>真实成分、功效、净含量、认证、包装尺寸和供应商参数。</dd></div></dl></div></section>
</PortfolioLayout>
