---
import { Image } from "astro:assets";
import brandReference from "@/assets/images/portfolio/aster-dew-brand-reference.png";
import campaign from "@/assets/images/portfolio/aster-dew-brand-lifestyle.png";
import banner from "@/assets/images/portfolio/aster-dew-brand-hero.png";
import variants from "@/assets/images/portfolio/aster-dew-brand-operations.png";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="Aster Dew：护肤品牌电商视觉" description="从品牌包装定义到商品场景、广告海报、详情页长图和运营多比例的护肤品视觉案例。" ogImage={banner.src}>
	<header class="project-hero site-shell"><p class="project-kicker">Case 08 / Beauty Commerce Visual</p><h1 class="project-title">Aster Dew：<br />一支精华的完整电商视觉。</h1><p class="project-lead">为 Aster Dew 建立鼠尾草绿与暖象牙白的包装语言，并围绕同一支精华延展白底主图、材质特写、生活方式场景、详情页长图、活动横幅和运营多比例。</p><div class="project-meta"><div><span class="meta-label">Product</span><strong>植物精华 / 纸盒包装</strong></div><div><span class="meta-label">Scope</span><strong>包装 / 主图 / 详情页</strong></div><div><span class="meta-label">Output</span><strong>1:1 / 3:4 / 16:9</strong></div><div><span class="meta-label">Focus</span><strong>产品与包装一致性</strong></div></div></header>
	<figure class="case-full-visual case-full-visual--wide"><a class="image-lightbox-link" href={banner.src} target="_blank" rel="noreferrer"><Image src={banner} alt="Aster Dew Botanical Serum 横版品牌场景海报" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="eager" /></a><figcaption>横版品牌场景海报：瓶身与纸盒均保留 ASTER DEW / BOTANICAL SERUM 品牌识别。</figcaption></figure>
	<section class="site-shell case-section"><div><p class="eyebrow">01 / Product &amp; Packaging</p><h2>包装先固定，场景再变化。</h2></div><div class="case-body"><figure class="case-full-visual case-full-visual--wide"><a class="image-lightbox-link" href={brandReference.src} target="_blank" rel="noreferrer"><Image src={brandReference} alt="Aster Dew 精华瓶与纸盒多视角品牌基准板" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>产品基准板：先固定瓶型、滴管、品牌标签、纸盒比例与植物线稿，再延展场景。</figcaption></figure></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">02 / Campaign Set</p><h2>竖版场景与横版活动图各自承担页面任务。</h2></div><div class="case-body"><div class="visual-wall visual-wall--two"><figure><a class="image-lightbox-link" href={campaign.src} target="_blank" rel="noreferrer"><Image src={campaign} alt="Aster Dew 精华与纸盒的浴室晨光广告场景" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" /></a><figcaption><strong>3:4 / LIFESTYLE</strong><span>石材浴室、晨光和水面反射强化清透质感。</span></figcaption></figure><figure><a class="image-lightbox-link" href={banner.src} target="_blank" rel="noreferrer"><Image src={banner} alt="Aster Dew 精华横版活动广告图" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 50vw" loading="lazy" /></a><figcaption><strong>16:9 / CAMPAIGN</strong><span>产品置于右侧，左侧保留品牌标题和活动信息安全区。</span></figcaption></figure></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">03 / Detail Page</p><h2>详情页先用品牌基准校对商品。</h2></div><div class="case-body"><figure class="case-full-visual case-full-visual--wide"><a class="image-lightbox-link" href={brandReference.src} target="_blank" rel="noreferrer"><Image src={brandReference} alt="Aster Dew 护肤精华品牌与包装详情板" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>详情页基准：品牌名、瓶身标签与纸盒图形都可以被直接核对，不再使用空白包装图。</figcaption></figure></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">04 / Operations</p><h2>同一商品进入不同运营版位。</h2></div><div class="case-body"><figure class="case-full-visual case-full-visual--wide"><a class="image-lightbox-link" href={variants.src} target="_blank" rel="noreferrer"><Image src={variants} alt="Aster Dew 精华的多版位运营组合" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>运营组合：保持瓶型、盖型、标签区和纸盒结构一致，再调整留白和商品排列。</figcaption></figure><div class="delivery-grid" style="margin-top:1.5rem"><div class="delivery-card"><span>1:1</span><h3>搜索与列表主图</h3><p>白底居中，缩略图下仍能识别瓶型与包装组合。</p></div><div class="delivery-card"><span>3:4</span><h3>详情首屏与社媒</h3><p>产品占据主要视野，同时保留短标题与卖点空间。</p></div><div class="delivery-card"><span>16:9</span><h3>首页活动横幅</h3><p>产品集中于一侧，另一侧保留活动信息安全区。</p></div></div></div></section>
</PortfolioLayout>
