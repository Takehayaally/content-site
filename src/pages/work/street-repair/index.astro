---
import { Image } from "astro:assets";
import repairProductSystem from "@/assets/images/portfolio/products/repair-product-system.png";
import repairHammerKit from "@/assets/images/portfolio/products/repair-hammer-kit.png";
import repairGoggles from "@/assets/images/portfolio/products/repair-goggles.png";
import repairSlingBag from "@/assets/images/portfolio/products/repair-sling-bag.png";
import repairWorkJacket from "@/assets/images/portfolio/products/repair-work-jacket.png";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="街区修补社：机能产品视觉系统" description="原创机能生活方式产品概念，展示产品组合、单品图、包装候选与陈列视觉。" ogImage={repairProductSystem.src}>
	<header class="project-hero site-shell"><p class="project-kicker">Case 06 / Lifestyle Product System</p><h1 class="project-title">街区修补社：机能产品视觉系统</h1><p class="project-lead">以工具、护目镜、斜挎包和工作夹克组成一套原创机能产品提案，强调单品可独立阅读、组合后仍保持统一识别。</p><div class="project-meta"><div><span class="meta-label">Scope</span><strong>产品视觉 / 包装 / 陈列</strong></div><div><span class="meta-label">Role</span><strong>产品定义 / 单品图 / 组合编排</strong></div><div><span class="meta-label">Output</span><strong>产品组合 / 单品 / 包装候选</strong></div><div><span class="meta-label">Status</span><strong>原创概念案例 / 待生产确认</strong></div></div></header>
	<figure class="case-full-visual case-full-visual--wide"><Image src={repairProductSystem} alt="街区修补社工具、服装、包袋与护目镜产品组合" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="eager" /><figcaption>产品组合图用于建立色彩、材质与机能语言；不代表真实品牌、实物量产或销售项目。</figcaption></figure>
	<section class="site-shell case-section"><div><p class="eyebrow">01 / Product Architecture</p><h2>先确定一套可扩展的产品语言。</h2></div><div class="case-body"><div class="delivery-grid"><div class="delivery-card"><span>FORM</span><h3>结构识别</h3><p>深蓝、黑色与橙色信号构成远距离识别。</p></div><div class="delivery-card"><span>FUNCTION</span><h3>机能线索</h3><p>挂点、模块、替换件和收纳关系进入单品设计。</p></div><div class="delivery-card"><span>RETAIL</span><h3>组合陈列</h3><p>单品可拆卖，组合图负责说明系列层级。</p></div></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">02 / Individual Products</p><h2>每件产品都能单独成为商品视觉。</h2></div><div class="case-body"><div class="detail-gallery"><figure><Image src={repairHammerKit} alt="磁铆锤模型套件与包装候选" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>HAMMER KIT</b><span>工具本体、替换件与包装。</span></figcaption></figure><figure><Image src={repairGoggles} alt="可换侧护片护目镜单品图" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>REPAIR GOGGLES</b><span>镜框、护片与替换关系。</span></figcaption></figure><figure><Image src={repairSlingBag} alt="模块维修斜挎包单品图" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>MODULAR SLING</b><span>模块口袋与挂载结构。</span></figcaption></figure><figure><Image src={repairWorkJacket} alt="双面机能工作夹克单品图" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>WORK JACKET</b><span>双面穿着与机能细节。</span></figcaption></figure></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">03 / Source &amp; Handoff</p><h2>角色立绘、刀模、PSD 和边缘检查一起交接。</h2></div><div class="case-body"><dl class="spec-table"><div><dt>网页展示</dt><dd>组合主图、单品图、详情页模块和系列阅读顺序。</dd></div><div><dt>设计文件</dt><dd>柚铁角色设定、亚克力背卡 SVG 刀模、PSD 分层源文件和透明边缘检查。</dd></div><div><dt>待确认</dt><dd>供应商材料、尺寸、公差、色彩、打样和量产记录。</dd></div></dl><a class="text-link" href="/downloads/source-files/repair-club-brand-spec.md" download>下载品牌规范 <span>↓</span></a> <a class="text-link" href="/downloads/source-files/repair-club-acrylic-dieline.svg" download>下载背卡刀模 <span>↓</span></a> <a class="text-link" href="/downloads/source-files/repair-club-acrylic-layered.psd" download>下载 PSD 分层文件 <span>↓</span></a> <a class="text-link" href="/work/source-file-index/">查看全部源文件 <span>↗</span></a><p class="boundary-note">本页是原创产品视觉概念，不将生成图写成真实商品、实物图、已签样或已上线销售。</p></div></section>
</PortfolioLayout>
