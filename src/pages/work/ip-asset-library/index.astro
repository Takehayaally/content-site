---
import { Image } from "astro:assets";
import moonlitCharacter from "@/assets/images/portfolio/moonlit-tea-character.webp";
import repairCharacter from "@/assets/images/portfolio/repair-club-character.webp";
import zhaoshuang from "@/assets/images/portfolio/zhaoshuang-character-system.webp";
import baijin from "@/assets/images/portfolio/baijin-four-views.webp";
import nova from "@/assets/images/portfolio/nova-four-views.webp";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="原创 IP：角色资产库与复用规则" description="将原创 IP 的角色设定、世界规则、素材状态、适用输出与源文件路径整理为可复用资产库。" ogImage={baijin.src}>
	<header class="project-hero site-shell"><p class="project-kicker">P0 / P1 Asset Management Case</p><h1 class="project-title">原创 IP 不是散图：它是一套可复用资产库。</h1><p class="project-lead">把角色设定、世界规则、提示词、透明素材、场景、商品与可编辑文件按项目归档，说明 AIGC 素材如何被管理、复用、检查并交给下一位设计师。</p><div class="project-meta"><div><span class="meta-label">Scope</span><strong>角色资产 / 世界观 / 文件归档</strong></div><div><span class="meta-label">Focus</span><strong>复用 / 版本 / QA</strong></div><div><span class="meta-label">Output</span><strong>资产索引 / 源文件包</strong></div><div><span class="meta-label">Status</span><strong>原创公开资产</strong></div></div></header>

	<section class="site-shell case-section"><div><p class="eyebrow">01 / Asset Families</p><h2>用同一规则管理不同题材的角色。</h2></div><div class="case-body"><div class="detail-gallery"><figure><Image src={zhaoshuang} alt="照霜角色资产设定板" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="eager" /><figcaption><b>照霜 / 时间奇幻</b><span>设定、时间规则、提示词与书签生产候选。</span></figcaption></figure><figure><Image src={baijin} alt="白烬角色资产设定板" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>白烬 / 科幻叙事</b><span>四视图、扩展角色、剧情关键帧、商品与 PSD。</span></figcaption></figure><figure><Image src={nova} alt="林澈角色资产设定板" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>林澈 / 城市科幻</b><span>四视图、场景任务、世界规则、商品与提示词。</span></figcaption></figure><figure><Image src={moonlitCharacter} alt="绛雪角色资产设定板" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>绛雪 / 品牌角色</b><span>角色、月蚀茶局品牌规范、SKU 与 SVG 刀模。</span></figcaption></figure><figure><Image src={repairCharacter} alt="柚铁角色资产设定板" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>柚铁 / 机能生活</b><span>角色、维修网络、商品、亚克力 PSD 与 SVG。</span></figcaption></figure></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">02 / Asset Contract</p><h2>每个项目都要回答“有什么、能做什么、是否能交”。</h2></div><div class="case-body"><div class="decision-table"><div class="decision-table__head"><span>资产层</span><span>必须保留</span><span>适用输出</span></div><div><b>角色基线</b><span>四视图/设定、配色、服装分区、道具与禁止漂移项。</span><span>人物初稿、表情、动作、分镜和系列图。</span></div><div><b>世界规则</b><span>环境、身份功能、事件逻辑、反复出现的符号与材质。</span><span>场景图、故事卡、商品命名与内容选题。</span></div><div><b>生产素材</b><span>透明 PNG、PSD/SVG、刀线、检查预览、版本与说明。</span><span>立牌、包装候选、详情页和供应商沟通前置材料。</span></div><div><b>QA 状态</b><span>通过稿、待补项、不可公开项和生产候选边界。</span><span>避免未确认内容混进展示、交付或后续生成。</span></div></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">03 / Reuse Path</p><h2>同一角色，可用在不同任务，不能失去同一身份。</h2></div><div class="case-body"><div class="system-map"><div class="system-node system-node--acid"><span>01 / SPEC</span><strong>设定与锚点</strong></div><div class="system-node"><span>02 / DRAFT</span><strong>GPT Image 候选</strong></div><div class="system-node system-node--ice"><span>03 / QA</span><strong>筛选与后期</strong></div><div class="system-node"><span>04 / REUSE</span><strong>场景 / 商品 / 文件</strong></div></div><p style="margin-top:1.5rem">复用时允许调整镜头、动作、环境和载体，但不允许无说明改变角色身份、核心服装、标志道具或产品结构。每次新增画面都先回到设定包，再进入候选与 QA。</p><a class="text-link" href="/work/aigc-draft-library/">查看初稿与筛选库 <span>↗</span></a> <a class="text-link" href="/work/source-file-index/">查看源文件 <span>↗</span></a></div></section>
</PortfolioLayout>
