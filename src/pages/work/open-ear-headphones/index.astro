---
import { Image } from "astro:assets";
import openEarHeadphonesCharging from "@/assets/images/portfolio/open-ear-headphones-charging.png";
import openEarHeadphonesDetail from "@/assets/images/portfolio/open-ear-headphones-detail.png";
import openEarHeadphonesHero from "@/assets/images/portfolio/open-ear-headphones-hero.png";
import openEarHeadphonesWorn from "@/assets/images/portfolio/open-ear-headphones-worn.png";
import openEarHeadphonesCommute from "@/assets/images/portfolio/open-ear-headphones-commute.png";
import openEarCampaignKv from "@/assets/images/portfolio/open-ear-campaign-kv.png";
import openEarCampaignProduct from "@/assets/images/portfolio/open-ear-campaign-product.png";
import openEarCampaignLifestyle from "@/assets/images/portfolio/open-ear-campaign-lifestyle.png";
import openEarCampaignDetail from "@/assets/images/portfolio/open-ear-campaign-detail.png";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="开放式耳机：跨境商品视觉概念" description="开放式耳机个人概念练习，展示 AI 辅助商品视觉生产、产品一致性检查与电商页面编排。" ogImage={openEarHeadphonesHero.src}>
	<header class="project-hero site-shell">
		<p class="project-kicker">Case 04 / Cross-border Product Visual</p><h1 class="project-title">开放式耳机：跨境商品视觉概念</h1>
		<p class="project-lead">以一款虚构开放式耳挂耳机为对象，建立白底主图、材质结构与充电收纳的统一商品视觉链路，并将产品信息留给网页后置排版。</p>
		<div class="project-meta"><div><span class="meta-label">Scope</span><strong>商品主图 / 详情模块</strong></div><div><span class="meta-label">Role</span><strong>产品定义 / AI 辅助生成 / 视觉 QA</strong></div><div><span class="meta-label">Output</span><strong>主图 / 细节 / 场景图</strong></div><div><span class="meta-label">Status</span><strong>个人概念练习 / 非真实上架</strong></div></div>
	</header>

	<figure class="case-full-visual case-full-visual--compact"><Image src={openEarHeadphonesHero} alt="深石墨色开放式耳挂耳机与椭圆充电盒的白底商品主图" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="eager" /><figcaption>虚构产品概念：不使用真实品牌、型号、认证、参数、价格、销量或平台表现。</figcaption></figure>

	<section class="site-shell case-section"><div><p class="eyebrow">01 / Product Anchor</p><h2>先定义同一件产品，再扩展图组。</h2></div><div class="case-body"><p>产品锚点限定为深石墨色耳挂、圆角触控面、银色材质过渡、柔和青绿色状态灯和扁椭圆充电盒。先完成并审核白底主图，再以它作为参考生成细节与收纳画面，减少同一商品在不同图里改变结构、比例或材质的问题。</p><ul class="case-points"><li><span>01</span><div><strong>开放式形态</strong><br />用耳挂轮廓和外露声学区传达开放式佩戴概念，不把它画成入耳式或头戴式耳机。</div></li><li><span>02</span><div><strong>商品阅读</strong><br />白底主图优先保证套装完整、轮廓清楚，并为页面中的人工文案留下空间。</div></li><li><span>03</span><div><strong>后置文字</strong><br />图片不承担型号、参数和认证信息，避免把生成文字误当成正式商品信息。</div></li></ul></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">02 / Detail System</p><h2>把材质与收纳拆成可检查的两张图。</h2></div><div class="case-body"><p>细节图核对触控区、耳挂、声学开口和材质转折；收纳图核对左右耳机的配对、充电盒内托和开盖关系。二者都以同一主图为参考，页面的卖点标题只描述设计意图，不虚构续航、音质、运动或医学承诺。</p><div class="detail-gallery"><figure><Image src={openEarHeadphonesDetail} alt="开放式耳机的耳挂、触控面、声学开口与银色材质过渡特写" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>MATERIAL &amp; TOUCH</b><span>将触控面、材质边界和耳挂轮廓拆开，作为页面文字与结构审核的依据。</span></figcaption></figure><figure><Image src={openEarHeadphonesCharging} alt="打开的深石墨色椭圆充电盒与一对开放式耳挂耳机" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>CHARGE &amp; STORE</b><span>核对左右耳机、内托和充电盒比例；它是视觉提案，不代表量产结构。</span></figcaption></figure><figure><Image src={openEarHeadphonesHero} alt="开放式耳机白底商品主图，用于确认整套产品识别" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 33vw" loading="lazy" /><figcaption><b>REFERENCE ANCHOR</b><span>将先通过审核的主图固定为参考锚点，避免每张生成图成为不同产品。</span></figcaption></figure></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">02A / Consistency Gate</p><h2>同一产品，跨图只允许有限变化。</h2></div><div class="case-body"><div class="consistency-matrix"><div><b>固定锚点</b><span>耳挂轮廓、触控面、银色过渡、青绿色状态灯</span><span>主图 / 细节 / 收纳 / 佩戴 / 通勤均须保留</span></div><div><b>可变因素</b><span>镜头、背景、人物、桌面与光线</span><span>只改变使用语境，不改变产品结构与比例</span></div><div><b>拒绝条件</b><span>入耳式轮廓、左右耳不成对、盒体比例漂移</span><span>直接退回候选，不用后期文字解释结构错误</span></div></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">03 / Lifestyle Reading</p><h2>先让产品被看清，再进入使用情境。</h2></div><div class="case-body"><p>佩戴图用于验证耳挂在耳廓上的位置和佩戴阅读；通勤场景将同一产品放进日常桌面环境，并保留足够留白供详情页后置文案使用。两张图只表达视觉应用场景，不延伸为性能、续航或健康功效承诺。</p><div class="case-gallery case-gallery--wide"><figure><Image src={openEarHeadphonesWorn} alt="成年人在通勤环境中正确佩戴开放式耳挂耳机" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption>WEAR POSITION / 耳挂位置与轮廓检查</figcaption></figure><figure><Image src={openEarHeadphonesCommute} alt="开放式耳机在通勤办公桌面的使用场景概念图" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption>COMMUTE CONTEXT / 留白用于后置详情文案</figcaption></figure></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">04 / E-commerce Modules</p><h2>把图组直接翻译成详情页模块。</h2></div><div class="case-body"><p>这组模块是面向跨境商品页的排版规划，先明确每张图承担的任务，再由人工补充正式参数与合规文案。</p><div class="delivery-grid"><div class="delivery-card"><span>MODULE 01</span><h3>Hero / 主图</h3><p>套装完整、轮廓清楚、背景干净，负责第一屏商品识别。</p></div><div class="delivery-card"><span>MODULE 02</span><h3>Material / 结构</h3><p>放大触控区、耳挂与材质转折，支撑局部卖点说明。</p></div><div class="delivery-card"><span>MODULE 03</span><h3>Context / 场景</h3><p>用佩戴和通勤场景补充使用语境，不替代性能证明。</p></div></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">04A / Campaign Extension</p><h2>同一产品，再延展一组广告与电商视觉。</h2></div><div class="case-body"><p>在商品基础图组之外，新增广告 KV、产品棚拍、运动生活方式和结构细节四类画面，补足 AI 美工与商品视觉岗位常见的整组交付能力。</p><div class="visual-wall"><figure><a class="image-lightbox-link" href={openEarCampaignKv.src} target="_blank" rel="noreferrer"><Image src={openEarCampaignKv} alt="开放式耳机运动广告 KV" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>CAMPAIGN KV / 广告主视觉</figcaption></figure><figure><a class="image-lightbox-link" href={openEarCampaignProduct.src} target="_blank" rel="noreferrer"><Image src={openEarCampaignProduct} alt="开放式耳机产品棚拍图" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>PRODUCT HERO / 产品主图</figcaption></figure><figure><a class="image-lightbox-link" href={openEarCampaignLifestyle.src} target="_blank" rel="noreferrer"><Image src={openEarCampaignLifestyle} alt="开放式耳机运动生活方式场景" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>LIFESTYLE / 运动场景</figcaption></figure><figure><a class="image-lightbox-link" href={openEarCampaignDetail.src} target="_blank" rel="noreferrer"><Image src={openEarCampaignDetail} alt="开放式耳机结构细节展示图" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="lazy" /></a><figcaption>DETAIL BOARD / 结构细节板</figcaption></figure></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">05 / SKU &amp; English Framework</p><h2>把跨境商品页需要的 SKU 与英文信息先搭好。</h2></div><div class="case-body"><p>颜色变体先以规格方向公开，不把尚未生成的独立渲染图伪装成成品；英文信息区只提供版式与卖点层级，不写未经产品资料确认的性能承诺。</p><div class="sku-board"><div><div class="sku-board__swatch"><i aria-hidden="true"></i><b>GRAPHITE / 主 SKU</b></div><p>深石墨色；当前已完成主图、结构、收纳与场景图组。</p></div><div><div class="sku-board__swatch sku-board__swatch--mist"><i aria-hidden="true"></i><b>MIST WHITE / 变体方向</b></div><p>雾白色；已定义配色方向，独立渲染图待生成与一致性验收。</p></div></div><div class="english-copy" style="margin-top:1.25rem"><div><b>OPEN-EAR FORM</b><span>Visual descriptor only</span></div><div><b>TOUCH SURFACE</b><span>Feature label placeholder</span></div><div><b>DAILY CONTEXT</b><span>Scene module heading</span></div></div></div></section>

	<section class="site-shell case-section"><div><p class="eyebrow">06 / Handoff</p><h2>交付时先交结构，再交画面。</h2></div><div class="case-body"><dl class="spec-table"><div><dt>主图组</dt><dd>01_hero / 02_detail / 03_charge，统一产品锚点与裁切安全区。</dd></div><div><dt>页面模块</dt><dd>模块标题、图片职责、留白位置和待补参数字段分开管理。</dd></div><div><dt>QA 门槛</dt><dd>左右耳配对、耳挂结构、材质边界、文字后置与事实边界逐项检查。</dd></div></dl><p class="boundary-note">当前公开的是网页展示型概念交付；没有把未生成的雾白 SKU、未确认参数或供应商文件伪装成成品。</p></div></section>
	<p class="site-shell" style="margin-top:-2rem"></p>

	<section class="site-shell case-section"><div><p class="eyebrow">07 / Production Method</p><h2>AI 负责候选，人负责统一与边界。</h2></div><div class="case-body"><p>本案例的工作顺序是：定义产品结构与禁用项，生成白底候选，选择可用的产品锚点，再生成参考图并对比结构。公开页面只展示通过审核的精选图，并明确它们是个人概念练习。SKU 色彩变体尚未生成，不以虚构图或文字替代。后续若继续制作变体，仍需围绕同一锚点审核，不将概念图表述为真实客户项目、真实上架商品或已验证的生产文件。</p></div></section>
</PortfolioLayout>
