---
import { Image } from "astro:assets";
import overview from "@/assets/images/portfolio/red-tide-overview.jpg";
import world from "@/assets/images/portfolio/red-tide-world.png";
import character from "@/assets/images/portfolio/red-tide-character.png";
import merch from "@/assets/images/portfolio/red-tide-merch.png";
import production from "@/assets/images/portfolio/red-tide-production.png";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="赤潮信标：角色到装备周边" description="原创 IP 赤潮信标的角色、世界观、装备周边与生产候选案例。" ogImage={overview.src}>
	<header class="project-hero site-shell"><p class="project-kicker">Case 10 / Original IP System</p><h1 class="project-title">赤潮信标：角色到装备周边</h1><p class="project-lead">用深海环礁、信号焰和维护装备建立一个能从角色设定延展到商品视觉的原创系统。</p><div class="project-meta"><div><span class="meta-label">Scope</span><strong>角色 / 世界观 / 商品</strong></div><div><span class="meta-label">Role</span><strong>视觉规范 / 资产编排</strong></div><div><span class="meta-label">Output</span><strong>KV / 周边 / 工艺候选</strong></div><div><span class="meta-label">Status</span><strong>原创概念案例</strong></div></div></header>
	<figure class="case-full-visual case-full-visual--wide"><Image src={overview} alt="赤潮信标原创 IP 作品展示总览" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 1240px" loading="eager" /><figcaption>从雾灯角色、赤潮环礁世界到装备周边的视觉链路。</figcaption></figure>
	<section class="site-shell case-section"><div><p class="eyebrow">01 / Character &amp; World</p><h2>让每个高亮都有功能理由。</h2></div><div class="case-body"><p>雾灯的装备、红色信号焰与深海维护语境共同承担角色识别；世界设定图把环礁、信标链和失压海域作为可复用的叙事背景。</p><div class="detail-gallery"><figure><Image src={character} alt="雾灯角色设定图" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" /><figcaption><b>CHARACTER ANCHOR</b><span>装备轮廓与信号色。</span></figcaption></figure><figure><Image src={world} alt="赤潮环礁世界设定图" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" /><figcaption><b>WORLD RULE</b><span>信标链、环礁与维护任务。</span></figcaption></figure></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">02 / Merch &amp; Handoff</p><h2>把维护装备翻译成可读的周边系统。</h2></div><div class="case-body"><div class="detail-gallery"><figure><Image src={merch} alt="赤潮信标周边组合视觉" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" /><figcaption><b>MERCH SYSTEM</b><span>收藏卡、立牌、挂件与胸针组合。</span></figcaption></figure><figure><Image src={production} alt="压力环与信号焰胸针生产候选预览" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" /><figcaption><b>PRODUCTION CANDIDATE</b><span>白墨、金属色与背扣沟通示例。</span></figcaption></figure></div><a class="text-link" href="/downloads/source-files/mistlight-character-world-spec.md" download>下载角色与世界设定 <span>↓</span></a> <a class="text-link" href="/downloads/source-files/mistlight-image-prompt.md" download>下载生图提示词 <span>↓</span></a><p class="boundary-note">本页是原创 IP 概念案例；工艺、尺寸与打样仍需供应商确认，不代表真实量产或发售。</p></div></section>
</PortfolioLayout>
