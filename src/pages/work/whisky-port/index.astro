---
import { Image } from "astro:assets";
import bowmoreBottle from "@/assets/images/portfolio/whisky-bowmore-bottle.webp";
import bowmoreLabel from "@/assets/images/portfolio/whisky-bowmore-label.jpg";
import hemingBottle from "@/assets/images/portfolio/whisky-heming-bottle.webp";
import hemingLabel from "@/assets/images/portfolio/whisky-heming-label.jpg";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="威士忌港：酒标与成品物料候选" description="任职期间酒类标签与商品物料资料的公开候选页，展示设计稿与实物应用对应关系。" ogImage={bowmoreLabel.src}>
	<header class="project-hero site-shell"><p class="project-kicker">Case 12 / Verified Project Candidate</p><h1 class="project-title">威士忌港：酒标与成品物料</h1><p class="project-lead">从任职期间保留的源文件与实物照片中，筛选两组“标签设计稿 → 成品应用”证据，补足电商、品牌与平面岗位的真实项目阅读。</p><div class="project-meta"><div><span class="meta-label">Context</span><strong>任职期间项目资料</strong></div><div><span class="meta-label">Evidence</span><strong>酒标稿 / 实物照片</strong></div><div><span class="meta-label">Use</span><strong>P2 电商 / 品牌岗位</strong></div><div><span class="meta-label">Status</span><strong>公开候选 / 职责待核对</strong></div></div></header>
	<section class="site-shell case-section"><div><p class="eyebrow">01 / Bowmore 1964</p><h2>标签信息如何落到真实瓶身。</h2></div><div class="case-body"><p>这一组资料包含横向酒标设计稿与同项目瓶身实拍，可用于说明品牌信息层级、版式比例和成品细节之间的对应关系。</p><div class="detail-gallery"><figure><Image src={bowmoreLabel} alt="Bowmore 1964 酒标设计稿" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" /><figcaption><b>DESIGN FILE</b><span>酒标版式、信息层级与品牌图形。</span></figcaption></figure><figure><Image src={bowmoreBottle} alt="Bowmore 1964 酒瓶标签实物照片" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" /><figcaption><b>APPLICATION PHOTO</b><span>瓶身标签的真实应用细节。</span></figcaption></figure></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">02 / 和鸣 古巴朗姆 30 年</p><h2>从插画标签到成品细节。</h2></div><div class="case-body"><p>这一组资料包含标签设计稿与瓶身局部照片，可用于阅读插画、字标、颜色和材质在成品上的关系。</p><div class="detail-gallery"><figure><Image src={hemingLabel} alt="和鸣古巴朗姆 30 年酒标设计稿" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" /><figcaption><b>DESIGN FILE</b><span>插画、字标和标签信息组织。</span></figcaption></figure><figure><Image src={hemingBottle} alt="和鸣古巴朗姆 30 年瓶身标签实物照片" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" /><figcaption><b>APPLICATION PHOTO</b><span>成品材质、颜色与标签细节。</span></figcaption></figure></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">03 / Project Notes</p><h2>设计稿与实物应用对应展示。</h2></div><div class="case-body"><dl class="spec-table"><div><dt>项目资料</dt><dd>本页使用用户提供的真实项目设计稿与实物照片。</dd></div><div><dt>展示内容</dt><dd>酒标与商品物料的版式、应用和成品对应关系。</dd></div><div><dt>职责说明</dt><dd>具体职责与品牌公开范围按项目实际情况说明。</dd></div></dl></div></section>
</PortfolioLayout>
