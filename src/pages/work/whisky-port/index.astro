---
import { Image } from "astro:assets";
import whiskyPoster from "@/assets/images/portfolio/whisky-port-poster.png";
import label01 from "@/assets/images/portfolio/whisky-selected-label-01-wemyss.jpg";
import label02 from "@/assets/images/portfolio/whisky-selected-label-02-glenhaven.jpg";
import label03 from "@/assets/images/portfolio/whisky-selected-label-03-rare-malts.jpg";
import label04 from "@/assets/images/portfolio/whisky-selected-label-04-laphroaig.jpg";
import label05 from "@/assets/images/portfolio/whisky-selected-label-05-dailuaine.jpg";
import label06 from "@/assets/images/portfolio/whisky-selected-label-06-benriach.jpg";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

	<PortfolioLayout title="威士忌港：酒标与品牌场景" description="酒类标签设计、品牌信息层级与场景海报的视觉案例。" ogImage={whiskyPoster.src}>
	<header class="project-hero site-shell"><p class="project-kicker">Case 12 / Label &amp; Brand Scene</p><h1 class="project-title">威士忌港：酒标与品牌场景</h1><p class="project-lead">从酒标设计稿出发，整理品牌信息层级、标签比例与一张场景海报，展示平面设计如何进入完整的品牌视觉语境。</p><div class="project-meta"><div><span class="meta-label">Context</span><strong>酒类品牌视觉</strong></div><div><span class="meta-label">Evidence</span><strong>酒标稿 / 场景海报</strong></div><div><span class="meta-label">Use</span><strong>标签 / 包装 / 广告画面</strong></div><div><span class="meta-label">Status</span><strong>设计稿与视觉提案</strong></div></div></header>
	<figure class="case-full-visual case-full-visual--wide"><Image src={whiskyPoster} alt="威士忌品牌场景海报" widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 66vw" loading="eager" /><figcaption>品牌场景海报：用暖木、琥珀酒液与低照度光线强化酒标的成熟质感。</figcaption></figure>
	<section class="site-shell case-section"><div><p class="eyebrow">01 / Selected Labels</p><h2>六款酒标，各自建立清晰的品牌识别。</h2></div><div class="case-body"><p>按选定顺序展示六款单一麦芽威士忌酒标。每款围绕产地、年份、酒厂与酒款信息建立不同的版式节奏，并以独立画面呈现。</p><div class="detail-gallery"><figure><Image src={label01} alt="Wemyss Malts 1983 Islay 单桶威士忌酒标设计展示" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>01 / WEMYSS MALTS</b><span>1983 Islay Single Cask Release</span></figcaption></figure><figure><Image src={label02} alt="Glenhaven Imperial 1976 单一麦芽威士忌酒标设计展示" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>02 / GLENHAVEN IMPERIAL</b><span>1976 · 18 Year Old</span></figcaption></figure><figure><Image src={label03} alt="Rare Malts Selection 1975 Milburn 单一麦芽威士忌酒标设计展示" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>03 / RARE MALTS SELECTION</b><span>Milburn · 1975 · 18 Year Old</span></figcaption></figure><figure><Image src={label04} alt="Laphroaig 25 年单一麦芽威士忌酒标设计展示" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>04 / LAPHROAIG</b><span>25 Year Old · Limited Release</span></figcaption></figure><figure><Image src={label05} alt="Dailuaine 34 年单一麦芽威士忌酒标设计展示" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>05 / DAILUAINE</b><span>1980 · 34 Year Old</span></figcaption></figure><figure><Image src={label06} alt="Benriach 26 年单一麦芽威士忌酒标设计展示" widths={[640, 960, 1400]} sizes="(max-width: 620px) 100vw, 50vw" loading="lazy" /><figcaption><b>06 / BENRIACH</b><span>1984 · 26 Year Old</span></figcaption></figure></div></div></section>
	<section class="site-shell case-section"><div><p class="eyebrow">03 / Project Notes</p><h2>设计稿与品牌场景延展。</h2></div><div class="case-body"><dl class="spec-table"><div><dt>项目资料</dt><dd>酒标设计稿与场景海报提案。</dd></div><div><dt>展示内容</dt><dd>版式、信息层级、色彩与品牌氛围的延展关系。</dd></div><div><dt>职责说明</dt><dd>页面以公开视觉材料和展示型提案为准。</dd></div></dl></div></section>
</PortfolioLayout>
