---
import { Image } from "astro:assets";
import ending from "@/assets/images/portfolio/short-video-detail-ending.jpg";
import middle from "@/assets/images/portfolio/short-video-detail-middle.jpg";
import opening from "@/assets/images/portfolio/short-video-detail-opening.jpg";
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
---

<PortfolioLayout title="动态卡段预演：三镜头连续性" description="用现有短视频关键帧组成可播放的动态卡段预演，展示镜头节奏、角色连续性和交付检查方法。" ogImage={opening.src}>
	<header class="project-hero site-shell"><p class="project-kicker">P0 Motion Card / Interactive Previs</p><h1 class="project-title">让分镜先动起来，再决定是否进入正式制作。</h1><p class="project-lead">这是一个可交互的动态卡段预演：把开场、转折、结尾三张关键帧按节奏串起来，先检查叙事方向、角色状态和视觉重点是否连续。它是静态关键帧的动效预演，不是正式成片或已上线视频。</p><div class="project-meta"><div><span class="meta-label">Format</span><strong>3 镜头 / 9 秒预演</strong></div><div><span class="meta-label">Checks</span><strong>节奏 / 连续性 / 重点</strong></div><div><span class="meta-label">Output</span><strong>动态卡段 / 镜头标注</strong></div><div><span class="meta-label">Status</span><strong>可播放预演原型</strong></div></div></header>

	<section class="motion-stage site-shell" data-motion-card aria-label="三镜头动态卡段预演"><div class="motion-stage__screen"><div class="motion-frame is-active" data-frame="0"><Image src={opening} alt="镜头一：短视频开场关键帧" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 760px" loading="eager" /><span class="motion-frame__label">01 / OPENING</span></div><div class="motion-frame" data-frame="1"><Image src={middle} alt="镜头二：短视频转折关键帧" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 760px" loading="lazy" /><span class="motion-frame__label">02 / TURN</span></div><div class="motion-frame" data-frame="2"><Image src={ending} alt="镜头三：短视频结尾关键帧" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 760px" loading="lazy" /><span class="motion-frame__label">03 / CLOSE</span></div><div class="motion-stage__hud"><span data-motion-counter>01 / 03</span><span data-motion-state>PLAYING</span></div></div><div class="motion-controls"><button type="button" data-motion-toggle>暂停</button><button type="button" data-motion-replay>重播</button><div class="motion-timeline" role="tablist" aria-label="镜头选择"><button type="button" role="tab" aria-selected="true" data-motion-tab="0">01<br /><small>开场</small></button><button type="button" role="tab" aria-selected="false" data-motion-tab="1">02<br /><small>转折</small></button><button type="button" role="tab" aria-selected="false" data-motion-tab="2">03<br /><small>结尾</small></button></div></div><div class="motion-progress" aria-hidden="true"><span data-motion-progress></span></div><p class="motion-caption" data-motion-caption>交代空间、角色和视觉锚点；先让观众知道“谁在什么地方”。</p></section>

	<section class="case-section site-shell"><div><p class="eyebrow">01 / Timing</p><h2>用节奏检查叙事，而不是只看三张图。</h2></div><div class="case-body"><p>每个镜头先给出一个短暂停留，再以淡入淡出切换；预演的意义是检查镜头之间是否有明确关系。若开场信息不足、转折动作跳变或结尾重点不回收，就在进入正式生图、生视频和剪辑前返工。</p><div class="motion-spec"><div><span>SHOT 01</span><strong>3.0 s</strong><p>建立空间与角色</p></div><div><span>SHOT 02</span><strong>3.0 s</strong><p>推进动作与视线</p></div><div><span>SHOT 03</span><strong>3.0 s</strong><p>回收重点与状态</p></div></div></div></section>

	<section class="case-section site-shell"><div><p class="eyebrow">02 / Continuity</p><h2>每次切换都要回答三个问题。</h2></div><div class="case-body"><div class="decision-table"><div class="decision-table__head"><span>检查项</span><span>通过信号</span><span>不通过时</span></div><div><b>角色状态</b><span>发型、服装、配件和情绪锚点延续。</span><span>退回角色参考与提示词，先修一致性。</span></div><div><b>动作方向</b><span>视线、身体朝向和重心能接上下一镜。</span><span>重排关键帧或调整镜头顺序。</span></div><div><b>视觉重点</b><span>开场交代、转折推进、结尾回收清晰。</span><span>删减无效画面，避免节奏拖沓。</span></div></div><p class="method-note">预演通过后才进入正式素材生产；当前页面展示的是可播放验证器，不代表已经完成声音、动态生成或最终剪辑。</p></div></section>

	<section class="case-section site-shell"><div><p class="eyebrow">03 / Handoff</p><h2>把“能不能做”变成下一步可执行的交付。</h2></div><div class="case-body"><p>镜头预演可以作为编剧、剪辑与视觉之间的共同检查面：编剧核对故事信息，剪辑核对节奏，设计师核对角色与画面连续性。通过后再交付关键帧编号、提示词版本、素材状态和需要补齐的镜头。</p><a class="text-link" href="/work/video-workflow/">返回 AI 短视频制作流程 <span>↗</span></a> <a class="text-link" href="/work/ajgc-designer/">返回 P0 岗位定向总览 <span>↗</span></a></div></section>

	<script>
		const root = document.querySelector("[data-motion-card]");
		if (root) {
			const frames = [...root.querySelectorAll("[data-frame]")]; const tabs = [...root.querySelectorAll("[data-motion-tab]")]; const counter = root.querySelector("[data-motion-counter]"); const state = root.querySelector("[data-motion-state]"); const caption = root.querySelector("[data-motion-caption]"); const progress = root.querySelector("[data-motion-progress]") as HTMLElement | null; const captions = ["交代空间、角色和视觉锚点；先让观众知道“谁在什么地方”。", "推进动作与视线；检查角色状态是否能接上下一镜。", "回收视觉重点与情绪；确认结尾是否留下清晰的下一步。"]; let current = 0; let playing = true; let timer: number | undefined;
			const render = (index: number) => { current = index; frames.forEach((frame, i) => frame.classList.toggle("is-active", i === index)); tabs.forEach((tab, i) => tab.setAttribute("aria-selected", String(i === index))); if (counter) counter.textContent = `0${index + 1} / 03`; if (caption) caption.textContent = captions[index]; if (progress) progress.style.width = `${((index + 1) / frames.length) * 100}%`; };
			const start = () => { clearInterval(timer); timer = window.setInterval(() => render((current + 1) % frames.length), 3000); if (state) state.textContent = "PLAYING"; }; render(0); start();
			root.querySelector("[data-motion-toggle]")?.addEventListener("click", (event) => { playing = !playing; (event.currentTarget as HTMLButtonElement).textContent = playing ? "暂停" : "播放"; if (playing) start(); else { clearInterval(timer); if (state) state.textContent = "PAUSED"; } });
			root.querySelector("[data-motion-replay]")?.addEventListener("click", () => { playing = true; const toggle = root.querySelector("[data-motion-toggle]"); if (toggle) toggle.textContent = "暂停"; render(0); start(); }); tabs.forEach((tab) => tab.addEventListener("click", () => { render(Number(tab.getAttribute("data-motion-tab"))); if (playing) start(); }));
		}
	</script>
</PortfolioLayout>
