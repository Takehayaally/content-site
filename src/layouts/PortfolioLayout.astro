---
import "@/styles/portfolio.css";

interface Props {
	title: string;
	description: string;
	ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const pageTitle = title === "NOVA" ? title : `${title} — NOVA`;
const currentPath = Astro.url.pathname;
const imageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
const navItems = [
	{ href: "/", label: "作品" },
	{ href: "/fanworks/", label: "同人创作" },
	{ href: "/systems/", label: "系统与工具" },
	{ href: "/journal/", label: "日志" },
	{ href: "/about/", label: "关于" },
	{ href: "/resume/", label: "经历" },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="NOVA" />
		<meta name="theme-color" content="#f3f1eb" />
		<link rel="canonical" href={Astro.url} />
		<link rel="icon" href="/favicon/favicon.ico" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="NOVA" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		{imageUrl && <meta property="og:image" content={imageUrl} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{imageUrl && <meta name="twitter:image" content={imageUrl} />}
	</head>
	<body class="portfolio-body">
		<a class="skip-link" href="#main-content">跳到主要内容</a>
		<header class="site-header">
			<div class="site-shell site-header__inner">
				<a class="site-brand" href="/" aria-label="NOVA 首页">
					<span class="site-brand__name">NOVA</span>
					<span class="site-brand__descriptor">VISUAL DESIGN / CREATIVE SYSTEMS</span>
				</a>
				<nav class="site-nav" aria-label="主要导航">
					{navItems.map((item) => (
					<a href={item.href} aria-current={(item.href === "/" ? currentPath === "/" || currentPath.startsWith("/work/") : currentPath === item.href || currentPath.startsWith(item.href)) ? "page" : undefined}>{item.label}</a>
					))}
				</nav>
			</div>
		</header>

		<main id="main-content" data-pagefind-body><slot /></main>

		<footer class="site-footer">
			<div class="site-shell site-footer__inner">
				<div>
					<strong>NOVA</strong>
					<p>二次元角色设计 · AIGC 图片与视频 · PS/AI 后期</p>
				</div>
				<div class="site-footer__links">
					<a href="/">全部作品</a>
					<a href="/fanworks/">同人创作</a>
					<a href="/systems/">系统与工具</a>
					<a href="/work/ajgc-designer/">岗位定向总览</a>
					<a href="/about/">关于与方法</a>
					<a href="/resume/">经历与能力</a>
					<a href="#main-content">返回顶部 ↑</a>
				</div>
			</div>
		</footer>
		<script>
			// Make standalone portfolio visuals inspectable at full resolution. Existing
			// links are left untouched to avoid nesting. Prefer the largest srcset
			// candidate so a click does not open the small responsive thumbnail.
			document.querySelectorAll<HTMLImageElement>("main img").forEach((image) => {
				if (image.closest("a") || image.dataset.lightboxReady === "true") return;
				const srcset = image.getAttribute("srcset");
				const srcsetCandidates = srcset?.split(",");
				const largestSrc = srcsetCandidates?.[srcsetCandidates.length - 1]?.trim().split(" ")[0];
				const link = document.createElement("a");
				link.className = "image-lightbox-link";
				link.href = largestSrc || image.currentSrc || image.src;
				link.target = "_blank";
				link.rel = "noreferrer noopener";
				link.setAttribute("aria-label", image.alt ? `打开大图：${image.alt}` : "打开大图");
				const picture = image.closest("picture");
				const wrapper = picture || image;
				wrapper.parentNode?.insertBefore(link, wrapper);
				link.appendChild(wrapper);
				image.dataset.lightboxReady = "true";
			});
		</script>
	</body>
</html>
